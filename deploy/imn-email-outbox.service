[Unit]
Description=Deliver queued Integrity Man Network email
After=imn-web.service

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 45 --request POST http://127.0.0.1:3000/api/internal/email-outbox
NoNewPrivileges=true
PrivateTmp=true
